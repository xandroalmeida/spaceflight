# Build
build*/
cmake-build-*/
compile_commands.json
.cache/

# Third-party toolkit: 42 MB download, fetched by scripts/fetch_cspice.sh
external/cspice/
# godot-cpp, fetched by scripts/fetch_godot_cpp.sh; version pinned there
external/godot-cpp/
# The Godot editor itself, fetched by scripts/fetch_godot.sh (152 MB)
external/godot/
external/*.tar.Z
external/*.tar
external/*.tar.gz
external/*.log

# SPICE kernels: data, versioned by NAIF, fetched by scripts/fetch_kernels.sh
kernels/spice/
kernels/*.log

# Lunar topography: LOLA LDEM, fetched by scripts/fetch_lunar_dem.sh (33 MB).
# Dado obtido, versionado por quem o produz -- mesma política dos kernels. O que
# o repositório guarda é o normal map DERIVADO dele, que tem 2,9 MB.
external/lola/

# Earth imagery: NASA Blue Marble NG, composto MODIS de nuvens e VIIRS Black
# Marble, obtidas por scripts/fetch_earth_textures.sh (68 MB). Mesma política.
# O que o repositório guarda são as três texturas DERIVADAS, com 10,4 MB.
external/nasa-earth/

# Star catalogue: data, fetched by scripts/fetch_star_catalog.sh
catalogs/bsc5.*
catalogs/SHA256SUMS

# Built GDExtension: produced by the build, not versioned
godot/project/bin/
godot/project/.godot/

# Outputs
*.csv
!tests/**/*.csv
# Scientific audit evidence is intentionally versioned beside its report.
!docs/validation/*.csv

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
