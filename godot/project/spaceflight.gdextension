[configuration]

entry_symbol = "spaceflight_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://bin/spaceflight.dylib"
macos.release = "res://bin/spaceflight.dylib"
linux.debug.x86_64 = "res://bin/spaceflight.so"
linux.release.x86_64 = "res://bin/spaceflight.so"
linux.debug.arm64 = "res://bin/spaceflight.so"
linux.release.arm64 = "res://bin/spaceflight.so"
windows.debug.x86_64 = "res://bin/spaceflight.dll"
windows.release.x86_64 = "res://bin/spaceflight.dll"
