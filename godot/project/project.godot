; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Spaceflight"
config/description="Scientific Solar System flight simulator -- rendering front end"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/resizable=true

; Sem isto o viewport fica preso no tamanho base e a janela só ganha borda: o
; desenho não acompanha o redimensionamento.
;
; canvas_items: o 3D é renderizado na resolução nativa da janela (nítido, sem
; upscale borrado) e a UI 2D é escalada pela razão em relação à base acima.
; expand: janela mais larga mostra MAIS cena na horizontal em vez de esticar a
; imagem -- o FOV vertical da câmera fica fixo, que é o comportamento correto
; para uma cena 3D.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
